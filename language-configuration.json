{
    "comments": {
        "lineComment": "#",
    },
    // symbols used as brackets
    "brackets": [
        ["(", ")"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        ["(", ")"],
        ["\"", "\""],
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["(", ")"],
        ["\"", "\""],
    ]
    // No "folding.markers": paren folding is a FoldingRangeProvider
    // (src/folding.ts). Markers are rendered as minimap section headers.
}