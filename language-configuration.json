{
    "comments": {
        "lineComment": "#",
    },
    // symbols used as brackets
    "brackets": [
        ["(", ")"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        ["(", ")"],
        ["\"", "\""],
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["(", ")"],
        ["\"", "\""],
    ],
    // Paren folding is a FoldingRangeProvider (src/folding.ts), which also
    // folds these regions. The markers exist so VS Code shows the text after
    // `# region` as a minimap section header. They MUST only match comment
    // lines: markers are rendered as headers, which is why the old `\(` start
    // marker put a label on nearly every line. Keep in sync with
    // REGION_START / REGION_END in src/folding.ts.
    "folding": {
        "markers": {
            "start": "^\\s*#\\s*region\\b",
            "end": "^\\s*#\\s*endregion\\b"
        }
    }
}